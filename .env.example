# Application
RSFMRI_ENVIRONMENT=development
RSFMRI_HOST=127.0.0.1
RSFMRI_PORT=8000
RSFMRI_DATABASE_URL=sqlite:///./work/neuroagent.db
RSFMRI_SERVE_FRONTEND=false
# WorkTask recovery claims are separate from the Workflow job/attempt lease.
# RSFMRI_AUTOMATION_CLAIM_LEASE_SECONDS=15
# Literature ingestion keeps originals under the work root. Defaults: 50 MiB,
# 600 approximate tokens per chunk, 100-token sentence overlap.
RSFMRI_LITERATURE_MAX_PDF_BYTES=52428800
RSFMRI_LITERATURE_CHUNK_TARGET_TOKENS=600
RSFMRI_LITERATURE_CHUNK_OVERLAP_TOKENS=100
# Reuse an existing fMRIAnalysis Chroma collection (install with uv sync --extra rag).
# RSFMRI_RAG_DB_DIR=C:/path/to/chroma_literature
RSFMRI_RAG_COLLECTION=fmri_literature_v1
RSFMRI_RAG_API_KEY_ENV=DASHSCOPE_API_KEY
RSFMRI_RAG_RERANK=true
# Real MATLAB/DPABI execution is opt-in and still requires per-run confirmation.
RSFMRI_ENABLE_REAL_EXECUTION=false

# Local data boundaries. Configure real absolute paths only in the untracked .env.
# RSFMRI_ALLOWED_SOURCE_ROOTS=C:\path\to\readonly-data
# RSFMRI_ALLOWED_WORK_ROOT=C:\path\to\rsfmri-work

# Local MATLAB stack is selected in the Web 环境 page on first use. These
# optional values are only startup fallbacks for headless/API deployments.
# RSFMRI_MATLAB_EXECUTABLE=C:\path\to\MATLAB\bin\matlab.exe
# RSFMRI_DPABI_DIR=C:\path\to\DPABI
# RSFMRI_SPM_DIR=C:\path\to\spm
RSFMRI_MATLAB_VERSION=unspecified
RSFMRI_SPM_VERSION=unspecified
RSFMRI_DPABI_VERSION=unspecified
RSFMRI_ADAPTER_VERSION=1.0.0

# Model profile secrets are referenced by environment-variable name only.
# The default secret file is this repository's untracked .env. Override only
# when the secret file must live elsewhere: RSFMRI_SECRETS_FILE=C:\secure\.env
# Generate a private random value of at least 16 characters in the local .env.
# RSFMRI_REDACTION_SALT=<local-random-value>
# DEEPSEEK_API_KEY=<local-secret>
# OPENAI_COMPATIBLE_API_KEY=<local-secret>

# Optional semantic long-term memory. The provider must implement the
# OpenAI-compatible POST /embeddings endpoint. Keep the real key only in .env.
# RSFMRI_MEMORY_EMBEDDING_PROFILE={"id":"memory-embedding","provider":"openai-compatible","base_url":"https://api.example.com/v1","model":"text-embedding-model","api_key_env":"MEMORY_EMBEDDING_API_KEY"}
# MEMORY_EMBEDDING_API_KEY=<local-secret>
# RSFMRI_MEMORY_RECALL_LIMIT=12
# RSFMRI_MEMORY_HALF_LIFE_DAYS=180
# RSFMRI_MEMORY_MINIMUM_SIMILARITY=0.45

# Bounded Agent tool loop. It additionally requires a model profile that declares
# the tool_use capability; a profile without it always uses the single-shot path.
# Every bound below is a hard stop. Set RSFMRI_AGENT_TOOL_LOOP_ENABLED=false to
# turn the loop off entirely and keep the pre-loop behaviour.
# RSFMRI_AGENT_TOOL_LOOP_ENABLED=true
# RSFMRI_AGENT_MAX_TOOL_STEPS=8
# RSFMRI_AGENT_MAX_TOOL_SECONDS=90
# RSFMRI_AGENT_MAX_TOOL_TOKENS=120000
# RSFMRI_AGENT_MAX_REPEAT_TOOL_FAILURES=2
# RSFMRI_WORK_MAX_HANDOFFS=6
# RSFMRI_AGENT_TOOL_RESULT_MAX_BYTES=65536

# DemoData acceptance harness. Both variables are needed to run real MATLAB
# acceptance; CI sets neither, so those tests always skip there.
# RSFMRI_DEMODATA_ROOT=<path-to-DemoData-copy>
# RSFMRI_RUN_DEMODATA_SMOKE=1
# RSFMRI_DEMODATA_LEVEL=1
