{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ALFF/fALFF request",
  "type": "object",
  "additionalProperties": false,
  "required": ["tr_seconds", "frequency_band", "requested_metrics", "requested_scalings", "mask_artifact_id", "filter_timing", "result_smoothing", "result_smoothing_fwhm_mm", "provenance"],
  "properties": {
    "tr_seconds": {"type": "number", "exclusiveMinimum": 0},
    "frequency_band": {
      "type": "object",
      "additionalProperties": false,
      "required": ["low_hz", "high_hz"],
      "properties": {
        "low_hz": {"type": "number", "minimum": 0},
        "high_hz": {"type": "number", "exclusiveMinimum": 0}
      }
    },
    "requested_metrics": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["alff", "falff"]}},
    "requested_scalings": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["raw", "global_mean", "z_score"]}},
    "mask_artifact_id": {"type": "string", "minLength": 1},
    "filter_timing": {"enum": ["disabled", "before_normalize", "after_normalize"]},
    "result_smoothing": {"type": "boolean"},
    "result_smoothing_fwhm_mm": {
      "oneOf": [
        {"type": "null"},
        {"type": "array", "prefixItems": [{"type": "number", "exclusiveMinimum": 0}, {"type": "number", "exclusiveMinimum": 0}, {"type": "number", "exclusiveMinimum": 0}], "items": false}
      ]
    },
    "provenance": {"type": "array", "minItems": 6, "uniqueItems": true, "items": {"$ref": "#/$defs/provenance"}}
  },
  "$defs": {
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "source", "evidence_ref"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "source": {"enum": ["user", "study_protocol", "dataset_metadata", "reviewed_preset"]},
        "evidence_ref": {"type": "string", "minLength": 1}
      }
    }
  }
}
