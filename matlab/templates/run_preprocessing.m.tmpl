% Generated from a validated JobSpec. Values are read from run-local files.
run('{{BOOTSTRAP_PATH}}');
run_directory = '{{RUN_DIRECTORY}}';
base_cfg_path = '{{BASE_CFG_PATH}}';
staging_directory = '{{STAGING_DIRECTORY}}';
subject_list_path = '{{SUBJECT_LIST_PATH}}';
config_json_path = '{{CONFIG_JSON_PATH}}';

request = jsondecode(fileread(config_json_path));
if request.builtin_base_cfg
    % DPARSFA loads its own Realign.mat job; no arbitrary base parameters inherit.
    Cfg = struct('Realign', struct('options_source', 'DPARSF/Jobmats/Realign.mat'));
    save(base_cfg_path, 'Cfg');
end
loaded = load(base_cfg_path);
assert(isfield(loaded, 'Cfg'), 'rsfmri:config:CfgMissing', 'Base configuration has no Cfg.');
Cfg = select_base_cfg(loaded.Cfg, request.base_cfg_allowed_fields);
Cfg = merge_struct(Cfg, request.overrides);
Cfg.DataProcessDir = staging_directory;
Cfg.ParallelWorkersNumber = 0;
auto_mask_requested = isfield(Cfg, 'MaskFile') && strcmp(Cfg.MaskFile, '__DPABI_AUTO_MASK__');
if auto_mask_requested
    Cfg.MaskFile = 'Default';
elseif isfield(Cfg, 'MaskFile') && ~strcmp(Cfg.MaskFile, 'Default')
    Cfg.MaskFile = fullfile(staging_directory, Cfg.MaskFile);
end
Cfg.SubjectID = cellstr(Cfg.SubjectID);
if ~isempty(request.t1_preparation)
    prepare_t1(Cfg, run_directory, staging_directory, request.t1_preparation);
end
if Cfg.IsNeedT1CoregisterToFun || Cfg.IsSegment || Cfg.IsDARTEL
    for index = 1:numel(Cfg.SubjectID)
        folder = fullfile(staging_directory, 'T1Img', Cfg.SubjectID{index});
        files = [dir(fullfile(folder, 'co*.nii')); dir(fullfile(folder, '*Crop*.nii'))];
        names = unique({files.name});
        assert(numel(names) == 1, 'rsfmri:t1:PreparedMissing', ...
            'Exactly one validated prepared T1 is required.');
        headers = spm_vol(fullfile(folder, names{1}));
        assert(numel(headers) == 1 && all(isfinite(headers.mat(:))) && ...
            abs(det(headers.mat(1:3,1:3))) > eps, 'rsfmri:t1:HeaderInvalid', ...
            'Prepared T1 must be a valid 3D image.');
    end
end
for index = 1:numel(Cfg.SubjectID)
    folder = fullfile(staging_directory, Cfg.StartingDirName, Cfg.SubjectID{index});
    zipped = dir(fullfile(folder, '*.nii.gz'));
    for file_index = 1:numel(zipped)
        gunzip(fullfile(folder, zipped(file_index).name), folder);
    end
    source_headers = read_series(folder);
    check_temporal(source_headers, Cfg.TR, Cfg.TimePoints);
end
cfg_mat_path = fullfile(run_directory, 'config', 'DPARSFACfg.mat');
save(cfg_mat_path, 'Cfg');

diary(fullfile(run_directory, 'logs', 'matlab.log'));
cleanup = onCleanup(@() diary('off'));
% Split at the actual unfiltered checkpoint so metrics never trust scheduled counts.
metric_cfg = Cfg;
has_metrics = Cfg.IsCalALFF || Cfg.IsCalReHo;
checkpoint_stage = timeseries_stage(Cfg);
save(cfg_mat_path, 'Cfg');
[Error, EffectiveCfg] = DPARSFA_run(cfg_mat_path, staging_directory, subject_list_path, 0);
if ~isempty(Error)
    error('rsfmri:dpabi:DPARSFAFailed', 'DPARSFA_run returned an error result.');
end
register_structural(Cfg, run_directory, staging_directory);
save(fullfile(run_directory, 'config', 'EffectiveCfg.mat'), 'EffectiveCfg');
if auto_mask_requested
    assert(isfield(EffectiveCfg, 'MaskFileForEachSubject') && ...
        numel(EffectiveCfg.MaskFileForEachSubject) == numel(Cfg.SubjectID), ...
        'rsfmri:mask:EffectiveMaskMissing', 'DPABI did not report the masks used for metrics.');
    auto_mask_paths = cell(numel(Cfg.SubjectID), 1);
    for index = 1:numel(Cfg.SubjectID)
        auto_mask_paths{index} = EffectiveCfg.MaskFileForEachSubject{index};
        assert(isfile(auto_mask_paths{index}), 'rsfmri:mask:AutoMaskMissing', ...
            'DPABI did not produce the effective metric mask for %s.', Cfg.SubjectID{index});
    end
    metric_cfg.MaskFile = auto_mask_paths{1};
end
checkpoints = struct([]);
for index = 1:numel(Cfg.SubjectID)
    subject = Cfg.SubjectID{index};
    headers = read_series(fullfile(staging_directory, checkpoint_stage, subject));
    expected = Cfg.TimePoints;
    if expected > 0, expected = expected - Cfg.RemoveFirstTimePoints; end
    if Cfg.IsScrubbing, expected = 0; end
    check_temporal(headers, Cfg.TR, expected);
    if has_metrics
        checkpoint_mask = metric_cfg.MaskFile;
        if auto_mask_requested, checkpoint_mask = auto_mask_paths{index}; end
        check_mask_grid(headers(1), checkpoint_mask);
        if metric_cfg.IsCalALFF
            check_band(metric_cfg.CalALFF.AHighPass_LowCutoff, ...
                metric_cfg.CalALFF.ALowPass_HighCutoff, Cfg.TR, numel(headers));
        end
        if metric_cfg.IsFilter
            check_band(metric_cfg.Filter.AHighPass_LowCutoff, ...
                metric_cfg.Filter.ALowPass_HighCutoff, Cfg.TR, numel(headers));
        end
    end
    destination = fullfile(run_directory, 'output', subject, 'timeseries.nii');
    if ~isfolder(fileparts(destination)), mkdir(fileparts(destination)); end
    spm_file_merge(headers, destination, 0, Cfg.TR);
    checkpoints(index).subject_id = subject;
    checkpoints(index).metadata = header_evidence(spm_vol(destination));
end
all_subject_ids = Cfg.SubjectID;
records = struct([]);
for index = 1:numel(request.outputs)
    output = request.outputs(index);
    destination = fullfile(run_directory, output.relative_path);
    checkpoint = checkpoints(strcmp({checkpoints.subject_id}, output.subject_id));
    temporal = checkpoint.metadata;
    output_mask = metric_cfg.MaskFile;
    if auto_mask_requested
        output_subject_index = find(strcmp(all_subject_ids, output.subject_id), 1);
        assert(~isempty(output_subject_index), 'rsfmri:mask:SubjectMissing', ...
            'No auto mask binding exists for %s.', output.subject_id);
        output_mask = auto_mask_paths{output_subject_index};
    end
    if strcmp(output.metric, 'brain_mask')
        copyfile(output_mask, destination);
    elseif ~strcmp(output.metric, 'timeseries')
        switch output.metric
            case 'alff', name = 'ALFFMap';
            case 'falff', name = 'fALFFMap';
            case 'reho', name = 'ReHoMap';
        end
        switch output.scaling
            case 'raw', scaling_prefix = '';
            case 'global_mean', scaling_prefix = 'm';
            case 'z_score', scaling_prefix = 'z';
            otherwise, error('rsfmri:output:UnknownScaling', 'Unknown scaling.');
        end
        prefix = '';
        result_directory = 'Results';
        if metric_cfg.IsSmooth && strcmp(metric_cfg.Smooth.Timing, 'OnResults')
            result_directory = EffectiveCfg.StartingDirName;
            assert(strcmp(result_directory, 'ResultsS'), ...
                'rsfmri:output:UnexpectedResultDirectory', ...
                'DPABI did not report the reviewed smoothed-result directory.');
        end
        if (metric_cfg.IsSmooth && strcmp(metric_cfg.Smooth.Timing, 'OnResults')) || ...
                (strcmp(output.metric, 'reho') && metric_cfg.CalReHo.SmoothReHo)
            prefix = 's';
        end
        filename = [prefix, scaling_prefix, name, '_', output.subject_id, '.nii'];
        matches = dir(fullfile(staging_directory, result_directory, '**', filename));
        assert(numel(matches) == 1, 'rsfmri:output:MissingOrAmbiguousMetric', ...
            'Expected exactly one declared metric output: %s.', filename);
        copyfile(fullfile(matches.folder, matches.name), destination);
        if strcmp(output.metric, 'reho')
            ready = read_series(fullfile(staging_directory, ...
                timeseries_stage(metric_cfg), output.subject_id));
            temporal = header_evidence(ready);
        end
    end
    headers = spm_vol(destination);
    if has_metrics, check_mask_grid(headers(1), output_mask); end
    finite_evidence = validate_output_values(headers, output.metric, ...
        has_metrics, output_mask);
    records(index).relative_path = output.relative_path;
    records(index).subject_id = output.subject_id;
    records(index).metric = output.metric;
    records(index).metadata = header_evidence(headers);
    records(index).tr_seconds = temporal.tr_seconds;
    records(index).volume_count = temporal.volume_count;
    records(index).finite_fraction = finite_evidence.finite_fraction;
    records(index).nonfinite_voxel_count = finite_evidence.nonfinite_voxel_count;
end
evidence = struct('outputs', records, 'checkpoints', checkpoints, ...
    'matlab', version, 'matlab_release', version('-release'), 'spm', spm('Ver'), ...
    'dparsfa_nargin', nargin('DPARSFA_run'), 'result_mode', 'real', ...
    'mask_grid_comparison', 'DPABI y_ReadRPI, axis flips only, no resampling');
fid = fopen(fullfile(run_directory, 'output', 'preprocessing-evidence.json'), 'w');
assert(fid ~= -1, 'rsfmri:output:EvidenceFile', 'Cannot open output evidence file.');
closer = onCleanup(@() fclose(fid));
fprintf(fid, '%s\n', jsonencode(evidence));
clear closer;

function stage = timeseries_stage(cfg)
stage = cfg.StartingDirName;
if cfg.IsSliceTiming, stage = [stage, 'A']; end
if cfg.IsRealign, stage = [stage, 'R']; end
if cfg.IsCovremove && strcmp(cfg.Covremove.Timing, 'AfterRealign'), stage = [stage, 'C']; end
if cfg.IsFilter && strcmp(cfg.Filter.Timing, 'BeforeNormalize'), stage = [stage, 'F']; end
if cfg.IsNormalize && strcmp(cfg.Normalize.Timing, 'OnFunctionalData'), stage = [stage, 'W']; end
if cfg.IsSmooth && strcmp(cfg.Smooth.Timing, 'OnFunctionalData'), stage = [stage, 'S']; end
if cfg.IsDetrend, stage = [stage, 'D']; end
if cfg.IsCovremove && strcmp(cfg.Covremove.Timing, 'AfterNormalize'), stage = [stage, 'C']; end
if cfg.IsFilter && strcmp(cfg.Filter.Timing, 'AfterNormalize'), stage = [stage, 'F']; end
if cfg.IsScrubbing, stage = [stage, 'B']; end
end

function headers = read_series(folder)
files = dir(fullfile(folder, '*.nii'));
assert(numel(files) == 1, 'rsfmri:input:ExpectedOne4DNifti', ...
    'Expected exactly one 4D NIfTI per subject and stage.');
headers = spm_vol(fullfile(files.folder, files.name));
assert(numel(headers) > 1, 'rsfmri:input:NotTimeseries', 'Input is not a 4D time series.');
end

function evidence = header_evidence(headers)
first = headers(1);
affine = first.mat;
tr = [];
if numel(headers) > 1
    tr = double(first.private.timing.tspace);
    assert(isfinite(tr) && tr > 0, 'rsfmri:metadata:MissingTR', 'NIfTI has no positive TR.');
end
evidence = struct('dimensions', double(first.dim), 'affine', affine, ...
    'voxel_size_mm', sqrt(sum(affine(1:3, 1:3).^2, 1)), ...
    'tr_seconds', tr, 'volume_count', numel(headers));
end

function check_temporal(headers, expected_tr, expected_count)
meta = header_evidence(headers);
assert(abs(meta.tr_seconds - expected_tr) < 1e-5, 'rsfmri:metadata:TRMismatch', ...
    'Actual NIfTI TR differs from the approved value.');
assert(expected_count == 0 || numel(headers) == expected_count, ...
    'rsfmri:metadata:CountMismatch', 'Actual volume count differs from the approved value.');
for index = 2:numel(headers), check_grid(headers(1), headers(index)); end
end

function check_grid(image, mask)
assert(isscalar(mask) && isequal(image.dim, mask.dim) && ...
    max(abs(image.mat - mask.mat), [], 'all') < 1e-5, 'rsfmri:metadata:GridMismatch', ...
    'Image and mask dimensions or physical voxel grids differ.');
end

function check_mask_grid(image, mask_path)
assert(isscalar(spm_vol(mask_path)), 'rsfmri:metadata:MaskNot3D', 'Mask must be 3D.');
% DPABI reads both arrays in RPI. Compare those exact grids, never resample.
[~, ~, image_rpi] = y_ReadRPI(image.fname, image.n(1));
[mask_values, ~, mask_rpi] = y_ReadRPI(mask_path);
assert(all(isfinite(mask_values), 'all') && any(mask_values ~= 0, 'all'), ...
    'rsfmri:metadata:InvalidMask', 'Mask must be finite and nonempty.');
check_grid(image_rpi, mask_rpi);
end

function check_band(low, high, tr, count)
resolution = 1 / (tr * count);
assert(high <= 1 / (2 * tr) && high >= resolution && ...
    (low == 0 || low >= resolution), 'rsfmri:metadata:FrequencyResolution', ...
    'Approved frequency band is incompatible with actual TR and volume count.');
end

function evidence = validate_output_values(headers, metric, has_metrics, mask_path)
finite_count = 0;
value_count = 0;
nonfinite_count = 0;
if strcmp(metric, 'timeseries')
    for volume = 1:numel(headers)
        values = spm_read_vols(headers(volume));
        assert(~any(isinf(values), 'all') && any(isfinite(values), 'all'), ...
            'rsfmri:output:InvalidTimeseries', ...
            'Each time-series volume requires finite support and no infinite values.');
        finite_count = finite_count + nnz(isfinite(values));
        value_count = value_count + numel(values);
        nonfinite_count = nonfinite_count + nnz(~isfinite(values));
    end
elseif strcmp(metric, 'brain_mask')
    values = spm_read_vols(headers(1));
    assert(all(isfinite(values), 'all') && any(values ~= 0, 'all'), ...
        'rsfmri:output:InvalidMask', 'Auto mask must be finite and nonempty.');
    finite_count = nnz(isfinite(values));
    value_count = numel(values);
else
    assert(has_metrics, 'rsfmri:output:MetricWithoutMask', ...
        'Metric output requires a declared mask.');
    [values, ~, image_rpi] = y_ReadRPI(headers(1).fname, headers(1).n(1));
    [mask_values, ~, mask_rpi] = y_ReadRPI(mask_path);
    check_grid(image_rpi, mask_rpi);
    inside = mask_values ~= 0;
    assert(any(inside, 'all') && all(isfinite(values(inside))), ...
        'rsfmri:output:NonfiniteMetricInMask', ...
        'Metric output contains nonfinite values inside the approved mask.');
    finite_count = nnz(isfinite(values));
    value_count = numel(values);
    nonfinite_count = nnz(~isfinite(values));
end
evidence = struct('finite_fraction', finite_count / value_count, ...
    'nonfinite_voxel_count', nonfinite_count);
end

function selected = select_base_cfg(source, allowed_fields)
selected = struct();
if ischar(allowed_fields) || isstring(allowed_fields)
    allowed_fields = cellstr(allowed_fields);
end
for index = 1:numel(allowed_fields)
    name = allowed_fields{index};
    assert(strcmp(name, 'Realign'), 'rsfmri:config:UnsupportedBaseCfgField', ...
        'Base configuration field is not allowlisted.');
    assert(isfield(source, name), 'rsfmri:config:AllowedBaseCfgFieldMissing', ...
        'Base configuration is missing an allowlisted field.');
    selected.(name) = source.(name);
end
end

function prepare_t1(Cfg, root, staging, mode)
if strcmp(mode, 'reorient_crop')
    program = fileparts(which('DPARSFA_run'));
    executable = 'dcm2nii_linux';
    if ispc, executable = 'dcm2nii.exe'; elseif ismac, executable = 'dcm2nii_mac'; end
    executable = fullfile(program, 'dcm2nii', executable);
    assert(isfile(executable), ...
        'rsfmri:t1:ConverterBinaryMissing', 'DPABI conversion binary is unavailable.');
    assert(isempty(regexp([staging executable], '["\x27;&|<>`$%\r\n]', 'once')), ...
        'rsfmri:t1:ConverterPathUnsupported', ...
        'DPABI conversion paths contain unsupported shell metacharacters.');
end
diary(fullfile(root, 'logs', 'matlab.log'));
cleanup = onCleanup(@() diary('off'));
cfg_path = fullfile(root, 'config', 'T1PreparationCfg.mat');
save(cfg_path, 'Cfg');
records = struct([]);
for index = 1:numel(Cfg.SubjectID)
    subject = Cfg.SubjectID{index};
    folder = fullfile(staging, 'T1Img', subject);
    if strcmp(mode, 'reorient_crop')
        raw = dir(fullfile(folder, '*.nii*'));
        assert(numel(raw) == 1, 'rsfmri:t1:RawAmbiguous', 'Exactly one bound T1 is required.');
        source = fullfile(folder, raw(1).name);
        command = sprintf('"%s" -g N -m N -n Y -r Y -v N -x Y -o "%s" "%s"', ...
            executable, folder, source);
        if ispc, command = ['"', command, '"']; end
        [status, diagnostic] = system(command);
        fprintf('%s\n', diagnostic);
        assert(status == 0, 'rsfmri:t1:ConverterFailed', 'T1 converter failed.');
    end
    files = [dir(fullfile(folder, 'co*.nii')); dir(fullfile(folder, '*Crop*.nii'))];
    names = unique({files.name});
    if strcmp(mode, 'reorient_crop'), names = setdiff(names, {raw(1).name}); end
    assert(numel(names) == 1, 'rsfmri:t1:PreparationAmbiguous', ...
        'Converter must produce exactly one reoriented cropped image.');
    source = fullfile(folder, names{1});
    headers = spm_vol(source);
    assert(numel(headers) == 1 && all(isfinite(headers.mat(:))) && ...
        abs(det(headers.mat(1:3,1:3))) > eps, 'rsfmri:t1:InvalidHeader', ...
        'Prepared T1 requires a finite nonsingular 3D header.');
    image = spm_read_vols(headers);
    assert(all(isfinite(image(:))) && any(image(:) ~= 0), ...
        'rsfmri:t1:InvalidData', 'Prepared T1 must contain finite nonzero data.');
    destination = fullfile(root, 'output', 't1', subject);
    mkdir(destination);
    copyfile(source, fullfile(destination, names{1}));
    extras = dir(fullfile(folder, '*.nii*'));
    for extra_index = 1:numel(extras)
        if ~strcmp(extras(extra_index).name, names{1})
            delete(fullfile(folder, extras(extra_index).name)); % staging copies only
        end
    end
    try
        review = figure('Visible', 'off');
        cleanup_figure = onCleanup(@() close(review));
        origin = headers.mat \ [0;0;0;1];
        center = max(1, min(size(image)', round(origin(1:3))));
        titles = {'Voxel sagittal (j/k)', 'Voxel coronal (i/k)', 'Voxel axial (i/j)'};
        slices = {squeeze(image(center(1),:,:))', squeeze(image(:,center(2),:))', image(:,:,center(3))'};
        cross = {[origin(2) origin(3)], [origin(1) origin(3)], [origin(1) origin(2)]};
        for plane = 1:3
            subplot(1,3,plane); imagesc(slices{plane}); axis image;
            title(titles{plane}); xlabel('voxel index'); ylabel('voxel index');
            xline(cross{plane}(1), 'r-'); yline(cross{plane}(2), 'r-');
        end
        sgtitle(sprintf('World origin = [%.1f %.1f %.1f] vox; affine axes: i=[%.2f %.2f %.2f], j=[%.2f %.2f %.2f], k=[%.2f %.2f %.2f]', ...
            origin(1:3), headers.mat(1:3,1), headers.mat(1:3,2), headers.mat(1:3,3)));
        colormap(gray); exportgraphics(review, fullfile(destination, 'inspection.png'));
        clear cleanup_figure;
    catch
        fprintf('Optional T1 inspection image could not be rendered.\n');
    end
    records(index).subject_id = subject;
    records(index).relative_path = ['output/t1/', subject, '/', names{1}];
    records(index).inspection_image = ['output/t1/', subject, '/inspection.png'];
    records(index).metadata = header_evidence(headers);
end
evidence = struct('operation', 't1_preparation', 'subjects', {Cfg.SubjectID}, ...
    'outputs', records, 'inspection_only', true);
fid = fopen(fullfile(root, 'output', 't1-preparation-evidence.json'), 'w');
assert(fid ~= -1, 'rsfmri:t1:EvidenceWrite', 'Cannot write preparation evidence.');
fprintf(fid, '%s', jsonencode(evidence)); fclose(fid);
end

function register_structural(Cfg, root, staging)
if ~Cfg.IsSegment && ~Cfg.IsDARTEL, return; end
directory = 'T1ImgSegment';
if Cfg.IsSegment == 2, directory = 'T1ImgNewSegment'; end
for index = 1:numel(Cfg.SubjectID)
    subject = Cfg.SubjectID{index};
    source = fullfile(staging, directory, subject);
    destination = fullfile(root, 'output', 'structural', subject);
    mkdir(destination);
    patterns = {'c1*.nii', 'c2*.nii', 'c3*.nii'};
    if Cfg.IsDARTEL, patterns = [patterns, {'rc1*.nii', 'rc2*.nii', 'u_*.nii'}]; end
    for pattern_index = 1:numel(patterns)
        files = dir(fullfile(source, patterns{pattern_index}));
        assert(numel(files) == 1, 'rsfmri:t1:StructuralMissing', ...
            'Required segmentation or DARTEL product missing or ambiguous.');
        header = spm_vol(fullfile(source, files(1).name));
        assert(all(isfinite(header(1).mat(:))), 'rsfmri:t1:StructuralHeader', ...
            'Structural output header must be finite.');
        copyfile(fullfile(source, files(1).name), fullfile(destination, files(1).name));
    end
end
if Cfg.IsDARTEL
    destination = fullfile(root, 'output', 'structural', 'templates'); mkdir(destination);
    for index = 1:6
        name = ['Template_', num2str(index), '.nii'];
        source = fullfile(staging, directory, Cfg.SubjectID{1}, name);
        assert(isfile(source), 'rsfmri:t1:TemplateMissing', 'DARTEL template missing.');
        copyfile(source, fullfile(destination, name));
    end
end
end

function target = merge_struct(target, overrides)
fields = fieldnames(overrides);
for index = 1:numel(fields)
    name = fields{index};
    value = overrides.(name);
    if isstruct(value) && isfield(target, name) && isstruct(target.(name))
        target.(name) = merge_struct(target.(name), value);
    else
        target.(name) = value;
    end
end
end
